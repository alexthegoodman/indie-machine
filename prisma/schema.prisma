// Allegiance (the MMO hosted at allegiance.indie-machine.com) keeps its durable world here:
// players and their sessions, nations (a player's party, with its save), the territory map
// between players, and world news. Live play (positions, street fights) runs on
// allegiance-realtime (Cloudflare Durable Objects), which reports outcomes back through the API.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Someone playing Allegiance. Anonymous until they claim an email and password.
model AllegiancePlayer {
  id           String    @id @default(cuid())
  email        String?   @unique
  passwordHash String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  /// Failed sign-ins in a row, and the time sign-in reopens after too many.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  sessions AllegianceSession[]
  nations  AllegianceNation[]

  @@map("allegiance_players")
}

/// One signed-in device. The bearer token itself is never stored, only its SHA-256.
model AllegianceSession {
  id         String           @id @default(cuid())
  tokenHash  String           @unique
  playerId   String
  player     AllegiancePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  lastUsedAt DateTime         @default(now())

  @@index([playerId])
  @@map("allegiance_sessions")
}

/// A party founded by a player ("New Nation / New Party"). A player has at most one active nation;
/// founding a new one ends the old, and its territory returns to the regimes.
model AllegianceNation {
  id        String           @id @default(cuid())
  playerId  String
  player    AllegiancePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  active    Boolean          @default(true)
  name      String
  leader    String
  ideology  String
  /// "#rrggbb"
  color     String
  homeName  String
  homeLat   Float
  homeLon   Float
  foundedAt DateTime         @default(now())
  endedAt   DateTime?
  /// The game's campaign JSON (members, money, skills, the strategic sim against the regimes).
  save      Json?
  saveVersion Int?
  savedAt   DateTime?

  territories AllegianceTerritory[]

  @@index([playerId, active])
  @@map("allegiance_nations")
}

/// A region or settlement that a nation holds, or once held. Region ids are the game's own:
/// the 113 world regions ("london") and settlements discovered from OpenStreetMap
/// ("place-<hash of name and coordinates>"), the same on every client.
model AllegianceTerritory {
  regionId   String            @id
  name       String
  kind       String
  lat        Float
  lon        Float
  /// Millions of people.
  pop        Float
  nationId   String?
  nation     AllegianceNation? @relation(fields: [nationId], references: [id], onDelete: SetNull)
  /// The regime faction that rules it when no nation does (and gets it back on release).
  aiGovernor String
  /// democracy | technocracy | junta | oligarchy
  gov        String
  /// The holder's troops stationed there, and its share of support (0..1), as last reported.
  army       Int               @default(0)
  support    Float             @default(0)
  takenAt    DateTime?
  updatedAt  DateTime          @updatedAt

  @@index([updatedAt])
  @@index([nationId])
  @@map("allegiance_territories")
}

/// World news: territory changing hands between nations, nations founded and fallen.
model AllegianceEvent {
  id       Int      @id @default(autoincrement())
  at       DateTime @default(now())
  kind     String
  text     String
  regionId String?
  nationId String?

  @@index([at])
  @@map("allegiance_events")
}

/// A product a visitor launched from the Visitor Launches bar. No account: the page's own
/// metadata fills the listing. `key` is what duplicate detection runs on: the bare host
/// ("acme.dev"), or host plus path on hosts that list many products ("github.com/a/b").
model VisitorLaunch {
  id          String   @id @default(cuid())
  key         String   @unique
  url         String
  host        String
  title       String
  tagline     String?
  imageUrl    String?
  iconUrl     String?
  /// SHA-256 of the submitter's IP plus a salt, only for rate limits.
  ipHash      String
  /// Set by hand to pull a listing without deleting it (the URL stays taken).
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@map("visitor_launches")
}

/// One thing a visitor did on the site: a page view, time spent on a page, a scroll milestone,
/// an outbound click, a search. Written in batches by /api/events, read by /insights.
/// Visitors are anonymous: `visitorId` is a random id kept in the browser's localStorage and
/// `sessionId` one kept in sessionStorage (a new one after 30 idle minutes). No IP is stored.
/// Session attribution (source, UTM, landing page) is copied onto every event of the session so
/// any event can be filtered by where its visitor came from without a join.
model AnalyticsEvent {
  id          BigInt   @id @default(autoincrement())
  at          DateTime @default(now())
  /// pageview | engage | read_depth | outbound_click | search | search_select | ... (see lib/analytics/events.ts)
  name        String
  visitorId   String
  sessionId   String
  path        String
  /// Referring host of the session ("news.ycombinator.com"), or "direct".
  source      String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// The first path of the session.
  entryPath   String
  country     String?
  city        String?
  /// The city's coordinates from Vercel's edge (a city centre, not the visitor), for the map.
  lat         Float?
  lon         Float?
  /// desktop | mobile | tablet | other
  device      String
  browser     String?
  os          String?
  screenW     Int?
  lang        String?
  /// Flat event properties: { href, text } for an outbound click, { pct } for read depth, ...
  props       Json?

  @@index([at])
  @@index([name, at])
  @@index([sessionId, at])
  @@index([visitorId, at])
  @@index([path, at])
  @@map("analytics_events")
}

/// One reader's answers to the survey that opens a post (lib/survey.ts). One row per visitor
/// per survey version. `visitorId`/`sessionId` are the analytics ids, so a response joins to
/// that visitor's events; source and landing page are the session's, copied at answer time.
model SurveyResponse {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  version     Int
  visitorId   String
  sessionId   String
  /// The post the survey was answered on.
  path        String
  /// Choice keys from lib/survey.ts, plus the optional free text under each question. A column
  /// is null on responses given while its question wasn't asked.
  work        String?
  workDetail  String?
  found       String
  foundDetail String?
  /// Referring host of the session ("news.ycombinator.com"), or "direct".
  source      String
  utmSource   String?
  entryPath   String
  country     String?
  /// desktop | mobile | tablet | other
  device      String
  lang        String?

  @@unique([visitorId, version])
  @@index([at])
  @@map("survey_responses")
}
